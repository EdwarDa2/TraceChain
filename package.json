{
  "name": "tracechain",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend", "packages/contracts"],
  "engines": { "node": ">=22 <23", "npm": ">=10 <11" },
  "scripts": {
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "db:up": "docker compose up -d postgres mongodb neo4j",
    "db:migrate": "node database/relational/migrate.mjs",
    "db:seed": "node database/relational/seed.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace backend",
    "test:e2e": "npm run test:e2e --workspace frontend",
    "benchmark": "node tests/benchmark/run.mjs",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript-eslint": "8.18.0"
  }
}
