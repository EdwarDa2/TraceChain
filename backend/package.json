{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:integration": "node ../tests/integration/engines-smoke.mjs && node --experimental-strip-types --test ../tests/integration/outbox.integration.mts && node ../database/graph/apply-schema.mjs && jest --config test/jest-integration.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.0.10",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.10",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/schedule": "6.0.0",
    "@nestjs/swagger": "11.0.3",
    "@nestjs/throttler": "6.4.0",
    "argon2": "0.43.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "decimal.js": "10.5.0",
    "joi": "17.13.3",
    "mongodb": "6.12.0",
    "neo4j-driver": "6.0.0",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.9.2"
  }
}
